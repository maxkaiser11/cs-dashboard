// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}
/// Users / tracked Steam accounts
model User {
  id          Int      @id @default(autoincrement())
  steamId     String   @unique @map("steam_id") @db.VarChar(20) // SteamID64
  displayName String?  @map("display_name")
  avatar      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  inventoryItems     InventoryItem[]
  inventorySnapshots InventorySnapshot[]

  @@map("users")
}

/// Current inventory items (one row per owned item)
model InventoryItem {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assetId        String  @map("asset_id") @db.VarChar(64) // Steam asset ID
  marketHashName String  @map("market_hash_name")         // e.g. "AK-47 | Redline (Field-Tested)"
  name           String?
  type           String?                                  // Weapon, Knife, Gloves, Sticker...
  exterior       String?                                  // Factory New, Minimal Wear...

  // Pricing (integer cents)
  priceCents  Int?    @map("price_cents")
  priceSource String? @map("price_source") // 'steam', 'buff', 'csfloat'...
  currency    String  @default("USD")

  // CS2-specific
  floatValue Decimal? @map("float_value") @db.Decimal(10, 8)
  paintSeed  Int?     @map("paint_seed")
  paintIndex Int?     @map("paint_index")
  phase      String?                       // Doppler phase etc.

  // Metadata
  iconUrl    String? @map("icon_url")
  tradable   Boolean @default(true)
  marketable Boolean @default(true)
  tradeProtected Boolean @default(false) @map("trade_protected")

  lastUpdated DateTime @default(now()) @updatedAt @map("last_updated") @db.Timestamptz(6)

  @@unique([userId, assetId])
  @@map("inventory_items")
}

/// Historical snapshots of total inventory value (for the chart)
model InventorySnapshot {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalValueCents Int      @map("total_value_cents")
  itemCount       Int      @map("item_count")
  currency        String   @default("USD")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@map("inventory_snapshots")
}
