//     display_name    TEXT,
//     created_at      TIMESTAMPTZ DEFAULT NOW()
// );
//
// -- Current inventory items (one row per owned item)
// CREATE TABLE inventory_items (
//     id                  SERIAL PRIMARY KEY,
//     user_id             INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
//
//     asset_id            VARCHAR(64) NOT NULL,          -- Steam asset ID (unique per item instance)
//     market_hash_name    TEXT NOT NULL,                 -- e.g. "AK-47 | Redline (Field-Tested)"
//     name                TEXT,
//     type                TEXT,                          -- Weapon, Knife, Gloves, Sticker, etc.
//     exterior            TEXT,                          -- Factory New, Minimal Wear, etc.
//
//     -- Pricing (store as integer cents to avoid float issues)
//     price_cents         INTEGER,                       -- current price in cents
//     price_source        TEXT,                          -- 'steam', 'buff', 'csfloat', etc.
//     currency            TEXT DEFAULT 'USD',
//
//     -- CS2-specific optional data
//     float_value         NUMERIC(10,8),
//     paint_seed          INTEGER,
//     paint_index         INTEGER,
//     phase               TEXT,                          -- Doppler phase, etc.
//
//     -- Metadata
//     icon_url            TEXT,
//     tradable            BOOLEAN DEFAULT true,
//     marketable          BOOLEAN DEFAULT true,
//
//     -- Tracking
//     last_updated        TIMESTAMPTZ DEFAULT NOW(),
//
//     UNIQUE (user_id, asset_id)
// );
//
// -- Historical snapshots of total inventory value (for the chart)
// CREATE TABLE inventory_snapshots (
//     id              SERIAL PRIMARY KEY,
//     user_id         INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
//     total_value_cents INTEGER NOT NULL,
//     item_count      INTEGER NOT NULL,
//     currency        TEXT DEFAULT 'USD',
//     created_at      TIMESTAMPTZ DEFAULT NOW()
// );
//
// -- Optional: index for fast history queries
// CREATE INDEX idx_snapshots_user_created 
//     ON inventory_snapshots (user_id, created_at DESC);
//
// CREATE INDEX idx_items_user 
//     ON inventory_items (user_id);

model Users {
    id Int @id @default(autoincrement())
    steamId String @unique
    displayName String
    avatar String?
    createdAt DateTime @default(now())
    updateAt DateTime @default(now())
  }
